{
  "name": "vulnmentor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "lint": "eslint",
    "validate": "node scripts/validate-vulnmentor.mjs",
    "security-check": "node scripts/security-regression.mjs",
    "migrate:sqlite": "node scripts/migrate-to-sqlite.mjs",
    "migrate:verify": "node scripts/migrate-to-sqlite.mjs --verify-only",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "migrate:postgres": "node scripts/migrate-to-postgres.mjs"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@sentry/nextjs": "^11.19.0",
    "better-sqlite3": "^13.0.3",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "overrides": {
    "postcss": "8.5.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
